# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交
# seekdb / OceanBase 连接信息（MySQL 协议）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2882
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sdd_context

# PowerContext Server
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
POWERCONTEXT_SCOPE=

# MiniMax（注意：Token Plan 要用订阅 Key，不是按量付费 Key）
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=replace-with-your-key
MINIMAX_MODEL=MiniMax-M3
